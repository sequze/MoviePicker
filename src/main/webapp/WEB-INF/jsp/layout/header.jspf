<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>MoviePicker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/static/css/styles.css" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/static/css/movies.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="${pageContext.request.contextPath}/">MoviePicker</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/movies">Фильмы</a></li>
            </ul>
            <ul class="navbar-nav">
                <c:if test="${sessionScope.user == null}">
                    <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/login">Войти</a></li>
                    <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/register">Регистрация</a></li>
                </c:if>
                <c:if test="${sessionScope.user != null}">
                    <li class="nav-item"><span class="navbar-text text-light">Привет, ${sessionScope.user.login}!</span></li>
                </c:if>
            </ul>
        </div>
    </div>
</nav>
<div class="container">